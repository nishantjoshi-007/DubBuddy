# Respeak configuration. Copy to .env and edit. Every value has a sensible default.

# Text-to-speech backend: kokoro (default, CPU, no cloning) or chatterbox (needs `uv sync --extra clone`, GPU recommended)
TTS_BACKEND=kokoro

# auto | cpu | cuda  (auto picks cuda when torch sees a GPU)
DEVICE=auto

# faster-whisper model: base (fast), small (default), medium, large-v3-turbo, large-v3
WHISPER_MODEL=small
# int8 on CPU, float16 on CUDA; override only if you know why
WHISPER_COMPUTE=int8

# limits
MAX_VIDEO_SECONDS=900
MAX_UPLOAD_MB=500
MAX_HEIGHT=720
MAX_CONCURRENT_JOBS=1
JOB_TTL_MINUTES=60

# storage (jobs live in DATA_DIR/jobs/<id>/; never under the static mount)
DATA_DIR=./data
# where downloaded models are cached (default: the libraries' own cache dirs)
# MODEL_CACHE_DIR=./data/models

# features
ALLOW_UPLOADS=true
# path to a Netscape cookies file for yt-dlp, if YouTube shows "Sign in to confirm you're not a bot"
# YTDLP_COOKIES_FILE=./cookies.txt

LOG_LEVEL=INFO

# update yt-dlp at startup (YouTube changes often; the Docker image turns this on by default)
YTDLP_AUTO_UPDATE=false
# languages `python -m respeak.prewarm` downloads Argos pairs and Kokoro voices for (comma-separated ISO codes)
PREWARM_LANGUAGES=en,es

# fitting the dub (D-49): speed speech up to this factor, then slow the video down up to this factor; never cut speech
MAX_SPEECH_SPEEDUP=1.3
MAX_VIDEO_STRETCH=1.15

# rate limit job submissions per client IP, e.g. 10/hour or 3/minute; empty = off (self-hosted default)
RATE_LIMIT_JOBS=
# honour X-Forwarded-For when behind a reverse proxy (only then!)
TRUST_PROXY=false
